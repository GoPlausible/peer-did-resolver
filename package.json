{
  "name": "peer-did-resolver",
  "version": "2.0.0",
  "description": "Resolve DID documents for did:peer",
  "type": "module",
  "source": "src/resolver.ts",
  "types": "./lib/resolver.d.ts",
  "files": [
    "lib",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./lib/resolver.js"
    }
  },
  "author": "Nick Reynolds <nick.reynolds@mesh.xyz>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:veramolabs/peer-did-resolver.git"
  },
  "dependencies": {
    "@aviarytech/did-peer": "link:../did-peer",
    "did-resolver": "^4.1.0"
  },
  "scripts": {
    "test": "jest",
    "test:ci": "jest --coverage",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.[jt]s\"",
    "lint": "eslint --ignore-pattern \"src/**/*.test.[jt]s\" \"src/**/*.[jt]s\"",
    "prepublishOnly": "yarn test:ci && yarn format && yarn lint",
    "release": "npx --yes -p semantic-release@25 -p @semantic-release/changelog@7 -p @semantic-release/git@11 semantic-release --debug"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!**/node_modules/**",
      "!**/__tests__/**"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s"
    ],
    "transformIgnorePatterns": [
      "/node_modules/@aviarytech/peer-did"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "babel-jest": "30.5.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "resolutions": {
    "yargs": "17.7.2"
  }
}
